{
  "schemaVersion": 1,
  "name": "Predicate: path exists",
  "trigger": {
    "type": "hotkey",
    "keys": [
      "CTRL",
      "ALT",
      "Y"
    ]
  },
  "actions": [
    {
      "id": "s1",
      "type": "if",
      "condition": {
        "type": "path_exists",
        "path": "C:\\Corpus\\notes"
      },
      "then": [
        {
          "id": "s1a",
          "type": "notify",
          "message": "there"
        }
      ]
    }
  ]
}
