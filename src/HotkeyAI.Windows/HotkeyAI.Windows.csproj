<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>HotkeyAI.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The only project that may reference Win32. Everything above it — Core, Engine — stays
         plain net10.0 so the DSL and the safety controls keep their Linux CI coverage. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HotkeyAI.Engine\HotkeyAI.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DPAPI, for the approval store. Needed explicitly here because this project does not
         reference WPF, which is what supplied it while the store lived in the agent. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Most of this project is Win32 calls that cannot be tested without a desktop, but the parts
         that are pure decisions can be, and they are the parts that go quietly wrong. -->
    <InternalsVisibleTo Include="HotkeyAI.Windows.Tests" />
  </ItemGroup>

</Project>
