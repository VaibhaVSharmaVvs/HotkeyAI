<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>HotkeyAI.Cli</RootNamespace>
    <AssemblyName>hotkeyai</AssemblyName>
    <!-- Windows-targeted since `run` executes plans against the real desktop, which needs
         HotkeyAI.Windows. Note this does not pull Core or Engine onto Windows: they remain
         plain net10.0 and keep their Linux CI coverage. The dependency points one way. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HotkeyAI.Core\HotkeyAI.Core.csproj" />
    <ProjectReference Include="..\HotkeyAI.Windows\HotkeyAI.Windows.csproj" />
  </ItemGroup>

</Project>
